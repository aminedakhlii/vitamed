generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  CLIENT
}

enum OrderStatus {
  QUOTE_REQUESTED
  QUOTE_APPROVED
  PRODUCTION_STARTED
  IN_PRODUCTION
  QUALITY_CHECK
  PACKED
  SHIPPED
  DELIVERED
}

enum QuotationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  COMPLAINT
  RETURN
  REPLACEMENT
  FEEDBACK
}

enum NotificationType {
  ORDER
  SHIPPING
  PAYMENT
  COMPLAINT
  FOLLOW_UP
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  language     String   @default("en")
  country      String?
  company      String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems       CartItem[]
  quotations      Quotation[]
  orders          Order[]
  notifications   Notification[]
  supportTickets  SupportTicket[] @relation("TicketClient")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  followUps       FollowUp[]      @relation("FollowUpClient")
  salesFollowUps  FollowUp[]      @relation("FollowUpSales")
}

model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String
  description     String
  specifications  String   @default("{}")
  colors          String   @default("[]")
  sizes           String   @default("[]")
  materials       String   @default("")
  certifications  String   @default("")
  modelNumber     String?
  imageUrl        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents    ProductDocument[]
  countryPrices CountryPrice[]
  cartItems    CartItem[]
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  name      String
  docType   String
  fileUrl   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CountryPrice {
  id        String  @id @default(cuid())
  productId String
  country   String
  currency  String
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, country])
}

model CartItem {
  id              String  @id @default(cuid())
  userId          String
  productId       String
  quantity        Int     @default(1)
  color           String?
  size            String?
  packaging       String?
  deliveryNotes   String?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, color, size])
}

model Quotation {
  id        String          @id @default(cuid())
  userId    String
  status    QuotationStatus @default(PENDING)
  items     String
  notes     String?
  incoterm  String?
  country   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String
  quotationId       String?
  status            OrderStatus @default(QUOTE_REQUESTED)
  incoterm          String?
  destinationCountry String?
  shippingCost      Float?
  estimatedDelivery DateTime?
  trackingNumber    String?
  items             String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotation         Quotation?  @relation(fields: [quotationId], references: [id])
  statusHistory     OrderStatusHistory[]
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  userId       String
  assignedToId String?
  type         TicketType
  subject      String
  description  String
  status       TicketStatus @default(OPEN)
  attachments  String       @default("[]")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation("TicketClient", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("TicketAssignee", fields: [assignedToId], references: [id])
}

model FollowUp {
  id           String   @id @default(cuid())
  clientId     String
  salesUserId  String?
  type         String
  subject      String
  message      String
  scheduledAt  DateTime
  completed    Boolean  @default(false)
  automated    Boolean  @default(true)
  createdAt    DateTime @default(now())
  client       User     @relation("FollowUpClient", fields: [clientId], references: [id], onDelete: Cascade)
  salesUser    User?    @relation("FollowUpSales", fields: [salesUserId], references: [id])
}
